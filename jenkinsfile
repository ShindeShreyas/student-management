pipeline {
    agent {
        label "worker"
    }

    tools {
        maven 'maven'
    }

    environment {
        my_aws_cred = credentials('aws-cred')
    }

    stages {
        stage('checkout'){
            steps{
                git 'https://github.com/ShindeShreyas/student-management.git'
                echo "cloning is successful"
            }
        }

        stage('Build') {
            steps {
                sg '''
                mvn clean package
                sudo snap install aws-cli --classic
                '''
            }
            post{
                success {
                    archiveArtifacts artifacts '**/target/*.war', fingurement: true
                }
            }
        }
        stage('Artifacts to s3') {
            steps {
                sh 'aws s3 cp target/*.war s3://shreyasbuilds.fun/Artifacts.war'
            }
        }

        stage('SonarQube Analysis'){
            steps{
                withSonarQube('Sonar'){
                    sh 'mvn sonar:sonar'
                }
            }
        }
        
        stage('Quality Gate'){
            steps{
                timeout(time: 5, units : 'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }
}